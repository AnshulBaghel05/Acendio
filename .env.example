VITE_CONTACT_EMAIL=""
VITE_CONTACT_LOCATION=""
VITE_TARGET_REGIONS=""
VITE_CONTACT_ADDRESS=""
VITE_GBP_URL=""

# Social Profile URLs (leave empty to omit)
