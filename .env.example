# GEMINI_API_KEY: Required for Gemini AI API calls if server features are added.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Brand & Domain Configuration
VITE_SITE_DOMAIN="https://[DOMAIN]"

# GoHighLevel (GHL) Integration Placeholders
VITE_GHL_WEBHOOK_URL="https://services.leadconnectorhq.com/hooks/[GHL_WEBHOOK_ID]"
VITE_GHL_FORM_EMBED_URL="https://api.leadconnectorhq.com/widget/form/[GHL_FORM_ID]"
VITE_GHL_CALENDAR_EMBED_URL="https://api.leadconnectorhq.com/widget/booking/[GHL_CALENDAR_ID]"
VITE_GHL_CHAT_WIDGET_SCRIPT_ID="[GHL_CHAT_WIDGET_ID]"
VITE_GHL_TRACKING_ID="[GHL_TRACKING_ID]"

# Consent-Gated Analytics & Pixel Placeholders
VITE_GA4_ID="[GA4_MEASUREMENT_ID]"
VITE_GTM_ID="[GTM_CONTAINER_ID]"
VITE_META_PIXEL_ID="[META_PIXEL_ID]"
VITE_CLARITY_ID="[MICROSOFT_CLARITY_ID]"
